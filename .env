# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marinade
DB_USER=fairfairehq
DB_PASSWORD=password

# Security Configuration
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
