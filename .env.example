# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marinade
DB_USER=fairfairehq
DB_PASSWORD=password
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT_SECONDS=5
# L'application doit se connecter avec un rôle NOSUPERUSER NOBYPASSRLS qui n'est
# pas propriétaire des tables (sinon l'isolation RLS est sans effet : l'API refuse
# de démarrer en production). Les migrations Alembic s'exécutent avec le rôle
# propriétaire du schéma :
# MIGRATION_DATABASE_URL=postgresql://marinade_owner:...@localhost:5432/marinade

# Security Configuration
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=15
VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Email Configuration
EMAIL_FROM=noreply@marinade.local

# Two-Factor Authentication
TWO_FACTOR_ISSUER=Marinade
# Chiffre les secrets TOTP en base. Vide = dérivé de SECRET_KEY (la faire tourner
# invalide alors les secrets 2FA existants : en production, définir une clé dédiée).
TWO_FACTOR_ENCRYPTION_KEY=

# Développement UNIQUEMENT : renvoie les jetons de vérification / réinitialisation
# dans la réponse HTTP, faute de fournisseur email/SMS. Refusé en production.
DEV_EXPOSE_AUTH_TOKENS=false

# Application Configuration
APP_NAME=Marinade API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
SKIP_DB_INIT=true

# Easy Transact
EASYTRANSACT_API_BASE_URL=https://api.easytransact.example
EASYTRANSACT_API_TOKEN=replace-with-secret-manager-reference
EASYTRANSACT_WEBHOOK_SECRET=replace-with-webhook-secret
EASYTRANSACT_WEBHOOK_SIGNATURE_HEADER=X-Signature
EASYTRANSACT_HTTP_TIMEOUT_SECONDS=10
ALLOW_LEGACY_PAYMENT_SIMULATION=false

# CORS Configuration
ALLOW_ORIGINS=http://localhost:3000
ALLOW_CREDENTIALS=true
ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID,X-Tenant-ID

# Server Configuration
HOST=0.0.0.0
PORT=8000
